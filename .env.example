# Скопіюй цей файл у .env і заповни. Сам .env НЕ комітиться в git.

# Токен від @BotFather
BOT_TOKEN=

# Юзернейми адмінів через кому (з @ або без)
ADMIN_USERNAMES=@kirpich_admin,@friend

# (необовʼязково) Telegram ID адмінів через кому — на випадок зміни юзернейму
ADMIN_IDS=

# (необовʼязково) ID закритого каналу (виду -1001234567890).
# Якщо задано — бот приймає заявки тільки в цей канал.
CHANNEL_ID=

# База даних. Локально — SQLite-файл. На Railway підставиться ${{Postgres.DATABASE_URL}}
DATABASE_URL=sqlite+aiosqlite:///bot.db

# Скільки повідомлень на секунду слати під час розсилки (ліміт Telegram ~30)
BROADCAST_RATE=25
